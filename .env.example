# URL de produção do webhook criado no n8n. Vazio = parser local.
N8N_WEBHOOK_URL=

# Enviado em X-Supfy-Webhook-Secret pela rota de servidor. Não coloque segredo real neste arquivo.
N8N_WEBHOOK_SECRET=

# true = não cai no parser local se o n8n falhar (a demo padrão faz fallback visível).
N8N_DISABLE_FALLBACK=false

# Handshake GET /api/inbound/whatsapp?hub.mode=subscribe (apenas demo local).
WHATSAPP_VERIFY_TOKEN=supfy-demo-verify-token
